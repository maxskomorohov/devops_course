Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "test-host" do |test|    # This name will go to inventory of Ansible (as applicable host)
    test.vm.hostname = "test-host"
    test.vm.network "public_network", bridge: "wlp2s0"

    # Basic VM Provisioning
    test.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
      vb.name = "test-host"
    end

    # Installing prerequisites with Ansible
    test.vm.provision "ansible" do |ansible|
        ansible.playbook = "ansible/playbook.yaml"
    end
  end

  config.vm.define "monitor-host" do |monitor|      # This name will go to inventory of Ansible (as applicable host)
    monitor.vm.hostname = "monitor-host"
    monitor.vm.network "public_network", bridge: "wlp2s0"

    # Basic VM Provisioning
    monitor.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
      vb.name = "monitor-host"
    end

    # Installing prerequisites with Ansible
    monitor.vm.provision "ansible" do |ansible|
        ansible.playbook = "ansible/playbook.yaml"
    end
  end
end
